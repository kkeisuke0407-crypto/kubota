---
import Analytics from '../../components/Analytics.astro';
import { affiliate } from '../../data/affiliate';
import { site } from '../../data/site';

type ImageItem = { file: string; width: number; height: number; alt: string; chapter?: boolean };
type ClusterView = 'cl07' | 'cl08' | 'fallback';
type PageItem = { type: 'image'; image: ImageItem; views?: ClusterView[] } | { type: 'cta'; location: string; label: string; note: string; final?: boolean };

const AFFILIATE_URL = affiliate.clickUrl;

const heroes = {
  cl07: { file: '/period-rejected/hero-cl07-period-reject.webp', width: 862, height: 1825, alt: '期間工に落ちたあと、応募条件と続けられる条件を確認して次を選ぶ案内' },
  cl08: { file: '/period-rejected/hero-cl08-easy-pass.webp', width: 928, height: 1694, alt: '受かりやすさを断定せず、応募条件・仕事内容・サポートを確認する案内' },
  fallback: { file: '/period-rejected/hero-default.webp', width: 1024, height: 1536, alt: '受かりやすさだけで選ぶ前に応募条件と続けられる条件を確認する案内' },
} satisfies Record<string, ImageItem>;

const specific = {
  result: { file: '/period-rejected/01-one-result.webp', width: 1024, height: 1536, alt: '1社の不採用だけですべての期間工の結果は決まらないという説明' },
  easyPassAnswer: { file: '/period-rejected/01-first-answer-cl08.webp', width: 1024, height: 1536, alt: '受かりやすさだけで決めず、募集対象・未経験応募・選考前サポートを確認する説明' },
  eligibility: { file: '/period-rejected/02-eligibility.webp', width: 1024, height: 1536, alt: 'クボタ筑波の現在の募集対象と雇入れ健康診断の注意' },
  support: { file: '/period-rejected/03-application-support.webp', width: 1024, height: 1536, alt: '応募サポートの案内と合格保証ではないという注意' },
  whyKubota: { file: '/period-rejected/04-why-kubota.webp', width: 1024, height: 1536, alt: '次の応募候補としてクボタ筑波を見る4つの理由' },
  checks: { file: '/period-rejected/04-four-checks.webp', width: 980, height: 1605, alt: '受かった後まで考える仕事内容・給与・勤務生活・寮勤務地の4条件', chapter: true },
  faqA: { file: '/period-rejected/10-faq-a.webp', width: 862, height: 1825, alt: '期間工の不採用、受かりやすいメーカー、未経験応募についてのFAQ' },
  faqEasyPass: { file: '/period-rejected/10-faq-cl08.webp', width: 862, height: 1825, alt: '受かりやすい期間工の選び方、メーカー比較、未経験応募についてのFAQ' },
  faqB: { file: '/period-rejected/11-faq-b.webp', width: 862, height: 1825, alt: 'クボタ筑波の採用、寮費、仕事のきつさについてのFAQ' },
  candidate: { file: '/period-rejected/09-next-candidate.webp', width: 864, height: 1821, alt: 'クボタ筑波を次の応募候補として確認しやすい人のチェック項目', chapter: true },
  final: { file: '/period-rejected/12-final.webp', width: 1024, height: 1536, alt: '受かるかだけでなく現在の募集条件と続けられる条件で判断するまとめ', chapter: true },
} satisfies Record<string, ImageItem>;

// 既存3Clusterと同じ完成画像をそのまま再利用する。画像自体は変更しない。
const common = {
  numbers: { file: '/lp-images-v5/01_four_numbers.webp', width: 1100, height: 1429, alt: 'クボタ筑波を判断するときの4数字' },
  jobs: { file: '/lp-images-v5/02_jobs_reality.webp', width: 941, height: 1672, alt: '5つの仕事内容と工程ごとの負担例', chapter: true },
  difficulty: { file: '/lp-images-v5/03_difficulty_varies.webp', width: 1042, height: 1510, alt: '同じ工場でも大変さが変わる理由' },
  training: { file: '/lp-images-v5/04_training_assignment.webp', width: 1024, height: 1536, alt: '未経験者向け研修と配属決定の流れ' },
  experience: { file: '/lp-images-v5/05_experience_examples.webp', width: 1008, height: 1561, alt: '仕事に慣れるまでの個人体験例' },
  shifts: { file: '/lp-images-v5/06_shifts_payday.webp', width: 1054, height: 1492, alt: '勤務時間、休日、給料日と社会保険', chapter: true },
  dorm: { file: '/lp-images-v5/07_dorm_confirmed.webp', width: 1019, height: 1544, alt: '寮費0円の条件と確認済みの家電' },
  apply: { file: '/lp-images-v5/12_precheck_apply.webp', width: 1024, height: 1536, alt: '応募前の3つの確認事項と必須6項目' },
} satisfies Record<string, ImageItem>;

const image = (value: ImageItem, views?: ClusterView[]): PageItem => ({ type: 'image', image: value, views });
const cta = (location: string, label: string, note: string, final = false): PageItem => ({ type: 'cta', location, label, note, final });

const items: PageItem[] = [
  cta('hero', 'クボタ筑波の現在の募集条件を確認する', '応募条件・仕事内容・給与・寮などを確認できます'),
  image(specific.result, ['cl07']), image(specific.easyPassAnswer, ['cl08', 'fallback']), image(specific.eligibility), image(specific.support), image(specific.whyKubota),
  cta('after_support', '応募条件とサポート内容を確認する', '採用を保証するものではありません。現在の案内をご確認ください'),
  image(specific.checks), image(common.numbers),
  cta('after_pay', '現在の給与・手当条件を確認する', '日給・月収例・満期慰労金・祝儀の最新条件を見る'),
  image(common.jobs), image(common.difficulty), image(common.training), image(common.experience), image(common.shifts), image(common.dorm),
  cta('after_dorm', '寮・勤務条件を含めて募集内容を見る', '入寮条件・勤務形態は応募前にご確認ください'),
  image(specific.candidate), image(common.apply), image(specific.faqA, ['cl07']), image(specific.faqEasyPass, ['cl08', 'fallback']), image(specific.faqB), image(specific.final),
  cta('final', 'クボタ筑波工場の現在の募集条件を確認する', '募集対象・仕事内容・給与・勤務時間・寮などを確認できます', true),
];

const canonical = new URL('/period-rejected/', Astro.site ?? 'https://kubota.hakobu-family.com');
---

<!doctype html>
<html lang="ja" data-hypothesis="PERIOD_REJECTED_DEFAULT">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#007b82" />
    <meta id="page-description" name="description" content="期間工に落ちた人、受かりやすいメーカーを探している人へ。採用を断定せず、クボタ筑波の応募条件・仕事内容・給与・勤務・寮を確認して次の候補を判断します。" />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <title>期間工の応募条件・仕事内容・給与を確認｜クボタ筑波</title>
    <script is:inline>
      (() => {
        let raw = '';
        try { raw = (new URLSearchParams(location.search).get('cluster_id') || '').trim().toUpperCase(); } catch (e) {}
        let shown = 'PERIOD_REJECTED_DEFAULT';
        let view = 'fallback';
        if (raw === 'CL07' || raw === 'CL07_PERIOD_REJECT') { shown = 'CL07_PERIOD_REJECT'; view = 'cl07'; }
        if (raw === 'CL08' || raw === 'CL08_PERIOD_EASY_PASS') { shown = 'CL08_PERIOD_EASY_PASS'; view = 'cl08'; }
        document.documentElement.dataset.hypothesis = shown;
        document.documentElement.dataset.clusterView = view;
        const heroByView = {
          cl07: { file: '/period-rejected/hero-cl07-period-reject.webp', width: 862, height: 1825, alt: '期間工に落ちたあと、応募条件と続けられる条件を確認して次を選ぶ案内' },
          cl08: { file: '/period-rejected/hero-cl08-easy-pass.webp', width: 928, height: 1694, alt: '受かりやすさを断定せず、応募条件・仕事内容・サポートを確認する案内' },
          fallback: { file: '/period-rejected/hero-default.webp', width: 1024, height: 1536, alt: '受かりやすさだけで選ぶ前に応募条件と続けられる条件を確認する案内' },
        };
        const hero = heroByView[view];
        const preload = document.createElement('link');
        preload.rel = 'preload';
        preload.as = 'image';
        preload.href = hero.file;
        preload.fetchPriority = 'high';
        document.head.appendChild(preload);
        const description = document.getElementById('page-description');
        if (view === 'cl07') { document.title = '期間工に落ちたら次はどうする？応募条件から確認｜クボタ筑波'; if (description) description.content = '期間工に落ちた・不採用だった人へ。採用を断定せず、クボタ筑波の応募条件、仕事内容、給与、勤務、寮を確認して次の候補を判断します。'; }
        if (view === 'cl08') { document.title = '受かりやすい期間工は？応募条件から比較｜クボタ筑波'; if (description) description.content = '受かりやすい期間工を探す人へ。採用率は断定せず、クボタ筑波の応募条件、未経験可否、仕事内容、給与、寮を確認して比較します。'; }
        window.__periodRejectHero = hero;
        window.__periodRejectShown = shown;
        window.__periodRejectAfterSupportLabel = view === 'cl07'
          ? '次の応募先として候補になるか確認する'
          : '応募条件とサポート内容を確認する';
      })();
    </script>
    <Analytics />
    <script is:inline>if (typeof window.gtag === 'function') window.gtag('config', 'AW-18129603657');</script>
  </head>
  <body>
    <main class="rejected-lp" aria-label="クボタ筑波 期間従業員の応募不安記事LP">
      <section class="hero-stack" aria-label="検索内容に合わせた最初の案内">
        <img id="cluster-hero" class="hero-image" src={heroes.fallback.file} alt={heroes.fallback.alt} width={heroes.fallback.width} height={heroes.fallback.height} loading="eager" fetchpriority="high" decoding="async" />
        <script is:inline>
          (() => {
            const image = document.getElementById('cluster-hero');
            const hero = window.__periodRejectHero;
            if (!image || !hero) return;
            image.alt = hero.alt;
            image.width = hero.width;
            image.height = hero.height;
            image.src = hero.file;
          })();
        </script>
      </section>

      {items.map((item) => item.type === 'image' ? (
        <section class:list={['rejected-section', 'rejected-image', { 'rejected-image--chapter': item.image.chapter, 'cluster-conditional': item.views }]} data-image={item.image.file} data-views={item.views?.join(' ')}>
          <img src={item.image.file} alt={item.image.alt} width={item.image.width} height={item.image.height} loading="lazy" decoding="async" />
        </section>
      ) : (
        <section class:list={['rejected-section', 'rejected-cta', { 'rejected-cta--final': item.final }]} aria-label="クボタ筑波の募集内容を確認">
          <p>{item.note}</p>
          <a class="rejected-cta__button" href={AFFILIATE_URL} target="_blank" rel="sponsored nofollow noopener" data-affiliate data-location={item.location}>
            <span data-dynamic-label={item.location === 'after_support' ? '' : undefined}>{item.label}</span><b aria-hidden="true">›</b>
          </a>
        </section>
      ))}
      <section class="text-version" aria-label="このページの内容をテキストで確認">
        <details>
          <summary>このページの内容をテキストで確認</summary>
          <div class="text-version__body">
            <div id="text-cluster-intro"><h2>応募先を条件から確認する</h2><p>採用結果だけでなく、応募条件、仕事内容、給与、勤務、寮を確認し、入社後に続けられる条件かまで見て判断します。</p></div>
            <section><h2>応募条件と応募サポート</h2><ul><li>現在の募集対象は、6ヶ月勤務可能な方、満18歳以上の方です。</li><li>雇入れ健康診断があります。健診結果の内容によっては、入職について別途相談となる場合があります。</li><li>現在の募集ページでは「合格に自信のない方でも大丈夫」「専門スタッフが万全サポート」という応募サポートが案内されています。</li></ul><p class="text-note">募集状況・募集条件は変更される場合があります。応募前に必ず公式募集ページの最新情報を確認してください。応募サポートの存在は、採用・合格を保証するものではありません。</p></section>
            <section><h2>給与・手当・寮</h2><dl><div><dt>最初の日給</dt><dd>14,000円</dd></div><div><dt>月収例</dt><dd>約34万円（20日勤務＋残業25時間＋昼勤のみの例）</dd></div><div><dt>満期慰労金</dt><dd>半年ごとに24万円。出勤率90%以上などの条件があります。</dd></div><div><dt>祝儀</dt><dd>14万円×年2回。支給日などの条件があります。</dd></div><div><dt>寮</dt><dd>入寮条件を満たす場合、家賃無料の案内があります。TV・冷蔵庫・洗濯機・電子レンジの記載があります。</dd></div></dl><p class="text-note">Wi-Fi、バス・トイレ、寝具、エアコン、駐車場、光熱費、通勤時間、門限、来客ルールは公開情報だけでは確認できません。応募前に確認してください。</p></section>
            <section><h2>仕事内容・大変さ・未経験</h2><p>主な仕事は、組立、塗装、溶接、機械加工、運搬です。立ち作業、繰り返し、重いもの、歩く量、暑さ、工具の振動などは工程で変わります。</p><ul><li>組立：部品を取り付けて製品を組み上げます。</li><li>塗装：製品や部品に色を塗ります。</li><li>溶接：金属のパーツをつなぎます。</li><li>機械加工：機械で部品を削り、できあがりを確認します。</li><li>運搬：部品を使う場所まで運びます。</li></ul><p>未経験者は安全ルール、作業の順番、部品や工具の使い方、異常時の止め方・伝え方を覚えてから配属されます。担当工程や勤務時間を自分で選べるとは案内されていません。</p><p class="text-note">ピッキングは3日〜1週間ほど、バリ取り・溶接は約1.5か月で慣れた本人例があります。いずれも特定の人・工程の体験で、全員に当てはまる内容ではありません。</p></section>
            <section><h2>勤務時間・休日・応募前の確認</h2><p>日勤8:00〜16:30、早番7:00〜15:30、遅番14:00〜22:30、夜勤20:00〜4:30の案内があります。5勤2休または4勤2休のパターンで、GW・夏・年末年始には長い休みがあります。6か月後、出勤率80%以上なら有給休暇10日。作業服・帽子・安全靴は無料貸与です。</p><p>応募前には、自分は寮に入れるか、勤務時間と担当する仕事はどう決まるか、自分の入社日で満期慰労金や祝儀を受け取れるかを確認します。</p></section>
            <section><h2>向いている人・FAQ</h2><p>今より給料を上げたい、1年で貯金を増やしたい、家賃の負担を減らしたい、未経験から工場で働きたい、関東で働きたい人は候補にしやすい一方、日勤だけ、軽い作業だけ、土日休みが絶対、担当する仕事を自分で選びたい人は応募前に確認が必要です。</p><h3>寮費は本当に0円？</h3><p>一人用の個室と家族寮について、寮費0円と案内されています。入寮には条件があります。</p><h3>寮の水道光熱費はいくら？</h3><p>募集ページには金額が出ていません。家具家電が標準で付くとは書かれていません。</p><h3>日勤だけで働ける？</h3><p>日勤・早番・遅番・夜勤があります。日勤だけを選べるとは書かれていません。</p><h3>担当する仕事は選べる？</h3><p>組立・塗装・溶接・機械加工・運搬があります。担当の決まり方は公開されていません。</p><h3>有給・社会保険は？</h3><p>6か月働き、出勤率80%以上なら有給休暇10日。社会保険は入社日から加入します。</p><h3>正社員を目指せる？</h3><p>1年以上働いた人を対象に、正社員を目指せる制度があります。</p></section>
          </div>
        </details>
      </section>
    </main>

    <footer class="rejected-footer">
      <section class="rejected-footer__info" aria-labelledby="rejected-footer-operator">
        <h2 id="rejected-footer-operator">運営者情報</h2>
        <dl>
          <div><dt>サイト名</dt><dd>{site.name}</dd></div>
          <div><dt>運営者</dt><dd>{site.operator}</dd></div>
          <div><dt>連絡先</dt><dd><a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></dd></div>
          <div><dt>事業内容</dt><dd>{site.business}</dd></div>
          <div><dt>親サイト</dt><dd><a href={site.parentUrl}>ハコぶファミリー（HAKOBU FAMILY）</a></dd></div>
        </dl>
        <p>当サイトはアフィリエイトプログラムを利用しており、リンク経由の応募により広告主から紹介料を受け取る場合があります。掲載内容は各社の公開情報をもとにしていますが、最新かつ正確な条件は応募先の公式情報をご確認ください。</p>
      </section>
      <nav class="rejected-footer__nav" aria-label="サイト内リンク"><a href="/">トップページ</a><a href="/privacy/">プライバシーポリシー</a><a href="/column/">コラム</a></nav>
      <p class="rejected-footer__copy">{site.copyright}</p>
    </footer>

    <script is:inline>
      (() => {
        const params = new URLSearchParams(location.search);
        const shown = window.__periodRejectShown || 'PERIOD_REJECTED_DEFAULT';
        const intro = document.getElementById('text-cluster-intro');
        const clusterIntro = {
          CL07_PERIOD_REJECT: '<h2>期間工に落ちた場合の考え方</h2><p>1社で不採用だったからといって、ほかの期間工まで同じ結果になると決まったわけではありません。メーカーごとに募集時期、募集状況、選考で見られる条件は異なります。</p><p>次の応募先を探すときは、現在の募集条件を確認し、入社後に続けられそうかまで見て判断します。</p>',
          CL08_PERIOD_EASY_PASS: '<h2>受かりやすい期間工を探す場合の考え方</h2><p>公開情報だけで「このメーカーが一番受かりやすい」と断定することはできません。自分が募集対象に合うか、未経験でも応募できるか、応募前にどんなサポートがあるかを確認して候補を絞ります。</p>',
        };
        if (intro && clusterIntro[shown]) intro.innerHTML = clusterIntro[shown];
        const dynamicLabel = document.querySelector('[data-dynamic-label]');
        if (dynamicLabel) dynamicLabel.textContent = window.__periodRejectAfterSupportLabel || dynamicLabel.textContent;
        const incoming = params.get('hypothesis') || '(none)';
        const lpPath = location.pathname;
        const trackedKeys = ['cluster_id', 'keyword', 'matchtype', 'campaignid', 'adgroupid', 'gclid'];
        const tracking = Object.fromEntries(trackedKeys.map((key) => [key, params.get(key) || '']));
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'lp_view', hypothesis: incoming, hypothesis_shown: shown, lp: lpPath, ...tracking });
        if (typeof window.gtag === 'function') window.gtag('event', 'lp_view', { debug_mode: !!window.__ga_debug, hypothesis: incoming, hypothesis_shown: shown, lp: lpPath, ...tracking });
        (function tagClarity(tries) {
          if (typeof window.clarity === 'function') { window.clarity('set', 'hypothesis', shown); window.clarity('set', 'lp', lpPath); return; }
          if (tries < 20) setTimeout(() => tagClarity(tries + 1), 500);
        })(0);
        document.querySelectorAll('[data-affiliate]').forEach((link) => {
          link.addEventListener('click', () => {
            const payload = { debug_mode: !!window.__ga_debug, hypothesis: incoming, hypothesis_shown: shown, lp: lpPath, cta_location: link.dataset.location || '', cta_label: (link.textContent || '').trim().slice(0, 60), ...tracking };
            window.dataLayer.push({ event: 'mcv_click', ...payload });
            window.dataLayer.push({ event: 'cta_click', ...payload });
            if (typeof window.gtag === 'function') window.gtag('event', 'mcv_click', payload);
            if (typeof window.gtag === 'function') window.gtag('event', 'cta_click', payload);
          });
        });
      })();
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html), :global(body) { margin: 0; padding: 0; overflow-x: clip; }
  :global(body) { background: #eef5f4; color: #1a2725; }
  .rejected-lp { --surface: #eef7f7; --rule: #b9dedd; width: 100%; max-width: 430px; margin: 0 auto; overflow: hidden; background: #fff; box-shadow: 0 0 36px rgb(0 66 71 / 10%); }
  .hero-stack, .rejected-section { position: relative; width: 100%; margin: 0; padding: 0; background: #fff; }
  .hero-image { display: block; width: 100%; height: auto; border: 0; }
  .cluster-conditional { display: none; }
  :global(html[data-cluster-view='cl07']) .cluster-conditional[data-views~='cl07'],
  :global(html[data-cluster-view='cl08']) .cluster-conditional[data-views~='cl08'],
