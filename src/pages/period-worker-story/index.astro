---
import { AFFILIATE_URL } from '../../data/kubota-lp3/content';
import { site } from '../../data/site';

type ImageSection = {
  file: string;
  width: number;
  height: number;
  alt: string;
  chapter?: 'comparison' | 'kubota' | 'decision';
};

type ArticleItem =
  | { type: 'image'; image: ImageSection }
  | { type: 'cta'; location: string; label: string; note: string };

const ctasAfterImage: Record<number, Extract<ArticleItem, { type: 'cta' }>> = {
  1: {
    type: 'cta',
    location: 'after_fv',
    label: 'まずはクボタ筑波の募集条件を見てみる',
    note: '給与・寮・勤務条件を先に確認する',
  },
  3: {
    type: 'cta',
    location: 'after_intro',
    label: '今のクボタ筑波の条件を先に確認する',
    note: '比較する前に、募集内容を見てみる',
  },
  9: {
    type: 'cta',
    location: 'after_dorm',
    label: '今のクボタ筑波の条件も見てみる',
    note: '比較の前に、クボタの募集条件を確認する',
  },
  15: {
    type: 'cta',
    location: 'after_comparison',
    label: '比較したうえで、クボタ筑波の条件を見る',
    note: 'クボタ筑波の給与・寮・勤務条件を確認する',
  },
  16: {
    type: 'cta',
    location: 'after_kubota_reveal',
    label: '今のクボタ筑波の募集条件を見てみる',
    note: 'クボタ筑波が気になったら、条件を確認する',
  },
  19: {
    type: 'cta',
    location: 'after_pay',
    label: '給与・満期慰労金の条件を確認する',
    note: '今の支給条件を詳しく見てみる',
  },
  22: {
    type: 'cta',
    location: 'after_life',
    label: '寮・勤務条件をまとめて確認する',
    note: '自分に合うか、募集条件を見てみる',
  },
  24: {
    type: 'cta',
    location: 'after_fit',
    label: '自分に合いそうなら、クボタ筑波の条件を見てみる',
    note: 'クボタ筑波の募集内容を確認する',
  },
};

const images: ImageSection[] = [
  { file: '/kubota-article-v2/01-hero.webp', width: 864, height: 1821, alt: '期間工を7年見てきたモデルストーリーのタイトルと、どこが一番いいかという導入' },
  { file: '/kubota-article-v2/02-old-criteria.webp', width: 864, height: 1821, alt: '月収や祝い金など大きな数字だけで選んでいた頃と、現在の判断軸の違い' },
  { file: '/kubota-article-v2/03-current-criteria.webp', width: 864, height: 1821, alt: 'クボタ筑波を比較候補の上位に置く理由とモデルストーリーであることの注意書き' },
  { file: '/kubota-article-v2/04-toyota-appeal.webp', width: 864, height: 1821, alt: 'トヨタの現在の日給や月収例など、王道メーカーとしての魅力' },
  { file: '/kubota-article-v2/05-toyota-reality.webp', width: 864, height: 1821, alt: '高待遇と楽は別であり、会社名だけでは実際の働きやすさが分からないという気づき' },
  { file: '/kubota-article-v2/06-denso-appeal.webp', width: 866, height: 1817, alt: 'デンソーの日給、月収例、長期一時金の強さ' },
  { file: '/kubota-article-v2/07-denso-reality.webp', width: 864, height: 1821, alt: '部品メーカーでも工程や働き方によって負担が異なるという体験章' },
  { file: '/kubota-article-v2/08-dorm-awareness.webp', width: 876, height: 1796, alt: '寮は無料かどうかだけでなく毎日帰る家として考えるという体験章' },
  { file: '/kubota-article-v2/09-dorm-checklist.webp', width: 864, height: 1821, alt: '個室、光熱費、家具家電、通勤、休日など寮選びの確認項目と他社の強み' },
  { file: '/kubota-article-v2/10-before-after.webp', width: 941, height: 1672, alt: '7年間で変わった期間工の選び方を最初の頃と今で比べた図', chapter: 'comparison' },
  { file: '/kubota-article-v2/11-five-criteria-a.webp', width: 863, height: 1822, alt: '期間工選びで確認する5項目のうち給料と満了金の見方' },
  { file: '/kubota-article-v2/12-five-criteria-b.webp', width: 864, height: 1821, alt: '期間工選びで確認する5項目のうち寮、仕事内容、立地の見方' },
  { file: '/kubota-article-v2/13-comparison-income.webp', width: 864, height: 1821, alt: 'トヨタ、デンソー、SUBARU、いすゞ、クボタ筑波の日給と掲載月収例の比較' },
  { file: '/kubota-article-v2/14-comparison-benefits-v2.webp', width: 864, height: 1821, alt: '5社の一時金、寮、比較時に見るポイントの比較' },
  { file: '/kubota-article-v2/15-comparison-note.webp', width: 862, height: 1824, alt: '月収例は残業や深夜勤務など条件が異なるため金額だけで単純比較できないという注意' },
  { file: '/kubota-article-v2/16-kubota-transition.webp', width: 864, height: 1821, alt: '2026年の今、総合バランスからクボタ筑波を候補に置く最大の転換点', chapter: 'kubota' },
  { file: '/kubota-article-v2/17-daily-pay.webp', width: 916, height: 1717, alt: 'クボタ筑波の日給14000円と昼勤20日、残業25時間で平均月収約34万円のモデル' },
  { file: '/kubota-article-v2/18-shifts.webp', width: 916, height: 1717, alt: '日勤、早番、遅番、夜勤など配属によって勤務帯が変わるという注意' },
  { file: '/kubota-article-v2/19-six-month-money.webp', width: 864, height: 1821, alt: '6か月ごとの満期慰労金24万円と条件付き祝儀14万円の支給条件' },
  { file: '/kubota-article-v2/20-apartment.webp', width: 864, height: 1821, alt: '会社契約の一般物件で家賃無料という条件と応募前に確認する住居項目' },
  { file: '/kubota-article-v2/21-work.webp', width: 864, height: 1821, alt: 'トラクタや産業用エンジンの仕事と、工程によって異なる負担を正直に説明する章' },
  { file: '/kubota-article-v2/22-tsukuba-life.webp', width: 864, height: 1821, alt: 'つくばみらい市とつくばエクスプレス沿線で休日の選択肢を考える章' },
  { file: '/kubota-article-v2/23-career.webp', width: 864, height: 1821, alt: '1年以上勤務した人を対象とする正社員登用制度の流れと注意' },
  { file: '/kubota-article-v2/24-fit.webp', width: 864, height: 1821, alt: '優先条件ごとのメーカー選びとクボタ筑波を比較したい人の特徴', chapter: 'decision' },
  { file: '/kubota-article-v2/25-closing-a.webp', width: 941, height: 1672, alt: '最大月収ではなく半年後や1年後にいくら残せそうかで選ぶという結論' },
  { file: '/kubota-article-v2/26-closing-b.webp', width: 864, height: 1821, alt: 'クボタを候補から外さず他社と並べて比較する提案' },
  { file: '/kubota-article-v2/27-final-guide.webp', width: 864, height: 1821, alt: '給与、勤務時間、寮、満期慰労金、募集状況を確認する最終案内' },
];

const items: ArticleItem[] = [];
images.forEach((image, index) => {
  items.push({ type: 'image', image });
  const cta = ctasAfterImage[index + 1];
  if (cta) items.push(cta);
});

const canonical = new URL('/period-worker-story/', Astro.site ?? 'https://kubota.hakobu-family.com');
import Analytics from '../../components/Analytics.astro';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f3ecdd" />
    <meta name="description" content="期間工を7年見てきたモデルストーリーを通じて、トヨタ、デンソー、SUBARU、いすゞとクボタ筑波の給料、寮、仕事、立地を正直に比較します。" />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <link rel="preload" as="image" href={images[0].file} fetchpriority="high" />
    <title>期間工を7年やって分かった。今ならクボタ筑波を候補の上に置く理由</title>
    <Analytics />
    <script is:inline>
      // Google広告のコンバージョンタグ。GA4とClarityは Analytics.astro に集約。
      if (typeof window.gtag === 'function') window.gtag('config', 'AW-18129603657');
    </script>
  </head>
  <body data-lp="period-worker-story" data-hypothesis="ARTICLE_STORY">
    <main class="article-lp" aria-label="クボタ筑波 期間従業員モデルストーリー記事LP">
      {items.map((item, index) => item.type === 'image' ? (
        <section class:list={['article-image', item.image.chapter && `article-image--${item.image.chapter}`]} data-image={item.image.file}>
          <img
            src={item.image.file}
            alt={item.image.alt}
            width={item.image.width}
            height={item.image.height}
            loading={index === 0 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : 'auto'}
            decoding="async"
          />
        </section>
      ) : (
        <section class="article-cta" aria-label="クボタ筑波の募集条件を確認">
          <p>{item.note}</p>
          <a class="article-cta__button" href={AFFILIATE_URL} target="_blank" rel="sponsored nofollow noopener" data-affiliate data-location={item.location}>
            <span>{item.label}</span><b aria-hidden="true">→</b>
          </a>
        </section>
      ))}

      <section class="article-cta article-cta--final" aria-label="給与・寮・勤務条件を確認">
        <p>給与・寮・勤務時間・現在の募集状況を見る</p>
        <a class="article-cta__button" href={AFFILIATE_URL} target="_blank" rel="sponsored nofollow noopener" data-affiliate data-location="final">
          <span>クボタ筑波工場の募集条件を確認する</span><b aria-hidden="true">→</b>
        </a>
      </section>
    </main>

    <footer class="article-footer">
      <section class="article-footer__info" aria-labelledby="article-footer-operator">
        <h2 id="article-footer-operator">運営者情報</h2>
        <dl>
          <div><dt>サイト名</dt><dd>{site.name}</dd></div>
          <div><dt>運営者</dt><dd>{site.operator}</dd></div>
          <div><dt>連絡先</dt><dd><a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></dd></div>
          <div><dt>事業内容</dt><dd>{site.business}</dd></div>
          <div><dt>親サイト</dt><dd><a href={site.parentUrl}>ハコぶファミリー（HAKOBU FAMILY）</a></dd></div>
        </dl>
        <p>当サイトはアフィリエイトプログラムを利用しており、リンク経由の応募により広告主から紹介料を受け取る場合があります。掲載内容は各社の公開情報をもとにしていますが、最新かつ正確な条件は応募先の公式情報をご確認ください。</p>
      </section>
      <nav class="article-footer__nav" aria-label="サイト内リンク"><a href="/">トップページ</a><a href="/privacy/">プライバシーポリシー</a><a href="/column/">コラム</a></nav>
      <p class="article-footer__copy">{site.copyright}</p>
    </footer>

    <script is:inline>
      (() => {
        const params = new URLSearchParams(location.search);
        // lp は LP1/LP2 と同じくパスで統一する（GA4のディメンションを揃えるため）
        const lpPath = location.pathname;
        const shown = 'ARTICLE_STORY';
        const incoming = params.get('hypothesis') || '(none)';
        const trackedKeys = ['cluster_id', 'keyword', 'matchtype', 'campaignid', 'adgroupid', 'gclid'];
        const tracking = Object.fromEntries(trackedKeys.map((key) => [key, params.get(key) || '']));
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'lp_view', hypothesis: incoming, hypothesis_shown: shown, lp: lpPath, ...tracking });
        if (typeof window.gtag === 'function') window.gtag('event', 'lp_view', { debug_mode: !!window.__ga_debug, hypothesis: incoming, hypothesis_shown: shown, lp: lpPath, ...tracking});
        // Clarityにも仮説とLPをタグ付けし、録画を絞り込めるようにする（LP1/LP2と同じ扱い）
        (function tagClarity(tries) {
          if (typeof window.clarity === 'function') {
            window.clarity('set', 'hypothesis', shown);
            window.clarity('set', 'lp', lpPath);
            return;
          }
          if (tries < 20) setTimeout(function () { tagClarity(tries + 1); }, 500);
        })(0);
        document.querySelectorAll('[data-affiliate]').forEach((link) => {
          // もしもの計測URLは書き換えない。付与したパラメータが転送を壊す可能性があるため、
          // 流入情報の紐付けはGA4イベント側（下の mcv_click）で行う。
          const destination = new URL(link.href);
          const isMoshimo = destination.hostname.endsWith('moshimo.com');
          if (!isMoshimo) {
            trackedKeys.forEach((key) => { const value = params.get(key); if (value) destination.searchParams.set(key, value); });
          }
          if (!isMoshimo) {
            destination.searchParams.set('hypothesis', 'ARTICLE_STORY');
            destination.searchParams.set('lp', 'period-worker-story');
            link.href = destination.toString();
          }
          link.addEventListener('click', () => { window.dataLayer.push({ event: 'mcv_click', hypothesis: incoming, hypothesis_shown: shown, lp: lpPath, cta_location: link.dataset.location || '', cta_label: (link.textContent || '').trim().slice(0, 60), ...tracking }); if (typeof window.gtag === 'function') window.gtag('event', 'mcv_click', { debug_mode: !!window.__ga_debug, hypothesis: incoming, hypothesis_shown: shown, lp: lpPath, cta_location: link.dataset.location || '', cta_label: (link.textContent || '').trim().slice(0, 60), ...tracking}); });
        });
      })();
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html), :global(body) { margin: 0; padding: 0; overflow-x: clip; }
  :global(body) { background: #e9e0cf; color: #282721; }
  .article-lp { width: 100%; max-width: 430px; margin: 0 auto; overflow: hidden; background: #f7f1e5; box-shadow: 0 0 42px rgb(64 51 27 / 16%); }
  .article-image { position: relative; width: 100%; margin: 0; padding: 0; overflow: hidden; background: #f7f1e5; font-size: 0; line-height: 0; }
  .article-image + .article-image { margin-top: -1px; }
  .article-image img { display: block; width: 100%; height: auto; margin: 0; border: 0; vertical-align: top; }
  .article-image--comparison, .article-image--kubota, .article-image--decision { padding-top: 14px; background: linear-gradient(180deg, #dfe9df 0 7px, #f7f1e5 7px 100%); }
  .article-cta { position: relative; padding: 30px 22px 34px; border-block: 1px solid rgb(74 112 102 / 20%); background: #f1eadc; text-align: center; }
  .article-cta::before { content: ''; position: absolute; inset: 11px auto auto 50%; width: 52px; height: 2px; border-radius: 999px; background: #9bb8ae; transform: translateX(-50%); }
  .article-cta p { margin: 0 0 14px; color: #4f5a54; font-family: 'Hiragino Kaku Gothic ProN', 'Yu Gothic', Meiryo, system-ui, sans-serif; font-size: 13px; font-weight: 650; line-height: 1.65; }
  .article-cta__button { display: grid; grid-template-columns: minmax(0, 1fr) 42px; align-items: center; gap: 8px; width: 100%; min-height: 68px; padding: 11px 12px 11px 20px; border: 1px solid #b95521; border-radius: 8px; background: #c8642b; box-shadow: 0 4px 0 #8f3b17, 0 12px 26px rgb(117 58 24 / 20%); color: #fffdf7; text-decoration: none; transform: translateY(0); transition: transform 140ms ease, box-shadow 140ms ease, background-color 140ms ease; -webkit-tap-highlight-color: transparent; }
  .article-cta__button span { min-width: 0; font-family: 'Hiragino Kaku Gothic ProN', 'Yu Gothic', Meiryo, system-ui, sans-serif; font-size: clamp(16px, 4.5vw, 19px); font-weight: 800; line-height: 1.45; letter-spacing: .01em; }
  .article-cta__button b { display: grid; width: 42px; height: 42px; place-items: center; border-radius: 50%; background: #fff8e9; color: #a8481d; font-family: Arial, sans-serif; font-size: 22px; line-height: 1; }
  .article-cta__button:hover { background: #d16b31; box-shadow: 0 5px 0 #8f3b17, 0 14px 30px rgb(117 58 24 / 24%); transform: translateY(-1px); }
  .article-cta__button:active { box-shadow: 0 1px 0 #8f3b17, 0 5px 12px rgb(117 58 24 / 18%); transform: translateY(3px); }
  .article-cta__button:focus-visible { outline: 4px solid rgb(56 110 99 / 40%); outline-offset: 4px; }
  .article-cta--final { padding-block: 34px 42px; background: #446f67; }
  .article-cta--final::before { background: rgb(255 247 229 / 50%); }
  .article-cta--final p { color: #fff8e9; }
  .article-cta--final .article-cta__button { border-color: #f0b078; background: #d36d31; box-shadow: 0 4px 0 #803814, 0 12px 28px rgb(35 28 18 / 25%); }
  .article-cta--final .article-cta__button span { font-size: clamp(15px, 4.2vw, 18px); }
  .article-footer { width: 100%; max-width: 430px; margin: 0 auto; padding: 30px 20px 34px; border-top: 1px solid #d7cbb8; background: #f9f4e9; color: #665f52; font-family: 'Hiragino Kaku Gothic ProN', 'Yu Gothic', Meiryo, system-ui, sans-serif; font-size: 13px; line-height: 1.7; }
  .article-footer__info { max-width: 360px; margin: 0 auto; }
  .article-footer__info h2 { margin: 0 0 10px; color: #3e6c63; font-size: 16px; line-height: 1.4; }
  .article-footer__info dl { display: grid; gap: 5px; margin: 0 0 12px; }
  .article-footer__info dl > div { display: grid; grid-template-columns: 5.5em minmax(0, 1fr); gap: 12px; }
  .article-footer__info dt, .article-footer__info dd { margin: 0; }
  .article-footer__info dt { color: #817868; }
  .article-footer__info dd { color: #342f27; }
  .article-footer a { color: #315f57; text-decoration: underline; text-underline-offset: .18em; }
  .article-footer a:focus-visible { outline: 3px solid #cc713c; outline-offset: 3px; }
  .article-footer__info p { margin: 0; }
  .article-footer__nav { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 16px; margin: 20px 0 14px; padding-top: 16px; border-top: 1px solid #ded4c3; }
  .article-footer__nav a { display: inline-flex; min-height: 44px; align-items: center; }
  .article-footer__copy { margin: 0; color: #817868; font-size: 12px; text-align: center; }
  @media (prefers-reduced-motion: reduce) { .article-cta__button { transition: none; } }
  @media (max-width: 430px) { .article-lp { box-shadow: none; } }
  @media (max-width: 350px) { .article-cta { padding-inline: 14px; } .article-cta__button { grid-template-columns: minmax(0, 1fr) 38px; padding-left: 14px; } .article-cta__button b { width: 38px; height: 38px; } }
</style>
