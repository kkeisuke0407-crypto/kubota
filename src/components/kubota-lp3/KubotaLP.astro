---
import { AFFILIATE_URL, clusters, type ClusterId } from '../../data/kubota-lp3/content';
import { site } from '../../data/site';

type Props = { clusterId: ClusterId };
type ImageId = 'numbers' | 'jobs' | 'difficulty' | 'training' | 'experience' | 'shifts' | 'dorm' | 'income' | 'savings' | 'comparison' | 'fit' | 'apply' | 'faq' | 'final';
type ImageItem = { file: string; width: number; height: number; alt: string };
type PageItem = { type: 'image'; image: ImageItem } | { type: 'cta'; location: string; label: string };

const { clusterId } = Astro.props;
const cluster = clusters[clusterId];
const canonical = new URL(`/${cluster.slug}/`, Astro.site ?? 'https://kubota.hakobu-family.com');

const heroByCluster: Record<ClusterId, ImageItem> = {
  FACTORY_UNEXP: { file: '/lp-images-v4/hero-factory-unexp.webp', width: 852, height: 1846, alt: '工場未経験でも研修と適性を見て配属されることを伝える導入' },
  PERIOD_INCOME: { file: '/lp-images-v4/hero-period-income.webp', width: 862, height: 1824, alt: 'モデルケースで1年後の貯金約337.5万円になる導入' },
  PERIOD_JOBDESC: { file: '/lp-images-v4/hero-period-jobdesc.webp', width: 864, height: 1821, alt: 'クボタ筑波の5つの仕事内容を伝える導入' },
};

const bodyImages: Record<ImageId, ImageItem> = {
  numbers: { file: '/lp-images-v4/01_four_numbers.webp', width: 862, height: 1825, alt: 'クボタ筑波を判断するときの4数字' },
  jobs: { file: '/lp-images-v4/02_jobs_reality.webp', width: 863, height: 1823, alt: '5つの仕事内容と工程ごとの負担例' },
  difficulty: { file: '/lp-images-v4/03_difficulty_varies.webp', width: 864, height: 1821, alt: '同じ工場でも大変さが変わる理由' },
  training: { file: '/lp-images-v4/04_training_assignment.webp', width: 862, height: 1825, alt: '未経験者向け研修と配属決定の流れ' },
  experience: { file: '/lp-images-v4/05_experience_examples.webp', width: 862, height: 1824, alt: '仕事に慣れるまでの個人体験例' },
  shifts: { file: '/lp-images-v4/06_shifts_payday.webp', width: 862, height: 1825, alt: '勤務時間、休日、給料日と社会保険' },
  dorm: { file: '/lp-images-v4/07_dorm_confirmed.webp', width: 862, height: 1825, alt: '寮費0円の条件と確認済みの家電' },
  income: { file: '/lp-images-v4/08_annual_income.webp', width: 862, height: 1824, alt: '1年間の給与モデルと条件付き一時金' },
  savings: { file: '/lp-images-v4/09_savings_model.webp', width: 932, height: 1688, alt: 'モデルケースで1年後の貯金約337.5万円になる試算' },
  comparison: { file: '/lp-images-v4/10_savings_compare.webp', width: 863, height: 1823, alt: '今の生活モデルとクボタ筑波モデルの1年後比較' },
  fit: { file: '/lp-images-v4/11_fit_career.webp', width: 862, height: 1825, alt: '候補になりやすい人と1年後の3つの選択肢' },
  apply: { file: '/lp-images-v4/12_precheck_apply.webp', width: 862, height: 1824, alt: '応募前の3つの確認事項と必須6項目' },
  faq: { file: '/lp-images-v4/13_faq.webp', width: 862, height: 1825, alt: '応募前によくある8つの質問' },
  final: { file: '/lp-images-v4/14_final.webp', width: 862, height: 1824, alt: 'この仕事と条件で1年間続けられそうかを判断するまとめ' },
};

const image = (id: ImageId): PageItem => ({ type: 'image', image: bodyImages[id] });
const cta = (location: string, label: string): PageItem => ({ type: 'cta', location, label });
const late = (): PageItem[] => [image('fit'), cta('after_fit', cluster.ctas.late), image('apply'), image('faq'), image('final'), cta('final', cluster.ctas.final)];

const itemsByCluster: Record<ClusterId, PageItem[]> = {
  FACTORY_UNEXP: [
    image('training'), cta('after_training', cluster.ctas.first), image('experience'), image('jobs'), cta('after_jobs', '仕事内容と募集条件を見る'),
    image('difficulty'), image('shifts'), image('dorm'), image('numbers'), image('income'), image('savings'), image('comparison'),
    cta('after_savings', cluster.ctas.afterSimulator), ...late(),
  ],
  PERIOD_INCOME: [
    image('numbers'), cta('after_numbers', cluster.ctas.first), image('income'), image('savings'), image('comparison'),
    cta('after_savings', cluster.ctas.afterSimulator), image('jobs'), cta('after_jobs', '仕事内容と募集条件を見る'),
    image('difficulty'), image('training'), image('experience'), image('shifts'), image('dorm'), ...late(),
  ],
  PERIOD_JOBDESC: [
    image('jobs'), cta('after_jobs', cluster.ctas.first), image('difficulty'), image('experience'), image('training'),
    cta('after_training', '未経験で働ける条件を見る'), image('shifts'), image('dorm'), image('numbers'), image('income'), image('savings'),
    image('comparison'), cta('after_savings', cluster.ctas.afterSimulator), ...late(),
  ],
};

const renderItems: PageItem[] = [
  { type: 'image', image: heroByCluster[clusterId] },
  cta('hero', '現在の募集条件を見る'),
  ...itemsByCluster[clusterId],
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#009688" />
    <meta name="description" content={cluster.description} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <link rel="preload" as="image" href={heroByCluster[clusterId].file} fetchpriority="high" />
    <title>{cluster.pageTitle}</title>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-2YLF06DC0E"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-2YLF06DC0E');
      gtag('config', 'AW-18129603657');
    </script>
  </head>
  <body data-hypothesis={cluster.id} data-lp={cluster.slug}>
    <main class="lp" aria-label="クボタ筑波 期間従業員の記事LP">
      {renderItems.map((item, index) => item.type === 'image' ? (
        <section class="lp-section lp-image" data-image={item.image.file}>
          <img src={item.image.file} alt={item.image.alt} width={item.image.width} height={item.image.height} loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} decoding="async" />
        </section>
      ) : (
        <section class="lp-section cta-block" aria-label="募集内容を確認">
          <a id={`cta-${item.location}`} class="cta-button" href={AFFILIATE_URL} target="_blank" rel="sponsored nofollow noopener" data-affiliate data-location={item.location}>
            <span>{item.label}</span><b aria-hidden="true">›</b>
          </a>
        </section>
      ))}
    </main>

    <footer class="lp-footer">
      <section class="lp-footer__info" aria-labelledby="lp-footer-operator">
        <h2 id="lp-footer-operator">運営者情報</h2>
        <dl>
          <div><dt>サイト名</dt><dd>{site.name}</dd></div>
          <div><dt>運営者</dt><dd>{site.operator}</dd></div>
          <div><dt>連絡先</dt><dd><a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></dd></div>
          <div><dt>事業内容</dt><dd>{site.business}</dd></div>
          <div><dt>親サイト</dt><dd><a href={site.parentUrl}>ハコぶファミリー（HAKOBU FAMILY）</a></dd></div>
        </dl>
        <p>当サイトはアフィリエイトプログラムを利用しており、リンク経由の応募により広告主から紹介料を受け取る場合があります。掲載内容は各社の公開情報をもとにしていますが、最新かつ正確な条件は応募先の公式情報をご確認ください。</p>
      </section>
      <nav class="lp-footer__nav" aria-label="サイト内リンク"><a href="/">トップページ</a><a href="/privacy/">プライバシーポリシー</a><a href="/column/">コラム</a></nav>
      <p class="lp-footer__copy">{site.copyright}</p>
    </footer>

    <script is:inline define:vars={{ hypothesis: cluster.id, lp: cluster.slug }}>
      (() => {
        const params = new URLSearchParams(location.search);
        const trackedKeys = ['keyword', 'matchtype', 'campaignid', 'adgroupid', 'gclid'];
        const tracking = Object.fromEntries(trackedKeys.map((key) => [key, params.get(key) || '']));
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'lp_view', hypothesis, lp, ...tracking });
        document.querySelectorAll('[data-affiliate]').forEach((link) => {
          const destination = new URL(link.href);
          trackedKeys.forEach((key) => { const value = params.get(key); if (value) destination.searchParams.set(key, value); });
          destination.searchParams.set('hypothesis', hypothesis);
          destination.searchParams.set('lp', lp);
          link.href = destination.toString();
          link.addEventListener('click', () => window.dataLayer.push({ event: 'cta_click', hypothesis, lp, cta_location: link.dataset.location || '', ...tracking }));
        });
      })();
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html), :global(body) { margin: 0; padding: 0; }
  :global(body) { background: #eef5f4; }
  .lp { width: 100%; max-width: 430px; margin: 0 auto; overflow: hidden; background: #fff; box-shadow: 0 0 36px rgb(0 66 71 / 10%); }
  .lp-section { position: relative; width: 100%; margin: 0; padding: 0; background: #fff; }
  .lp-section + .lp-section { margin-top: -1px; }
  .lp-image { overflow: hidden; font-size: 0; line-height: 0; }
  .lp-image img { display: block; width: 100%; height: auto; margin: 0; border: 0; vertical-align: top; }
  .cta-block { padding: 24px 22px 25px; line-height: 1.4; }
  .cta-button { display: grid; grid-template-columns: minmax(0, 1fr) 44px; align-items: center; gap: 10px; width: 100%; min-height: 76px; padding: 12px 14px 12px 22px; border: 1px solid #ff6a00; border-radius: 999px; background: linear-gradient(180deg, #ff741a 0%, #ff5a00 100%); box-shadow: 0 5px 0 #cf4100, 0 10px 24px rgb(255 91 0 / 22%); color: #fff; text-decoration: none; transform: translateY(0); transition: transform 140ms ease, box-shadow 140ms ease, filter 140ms ease; -webkit-tap-highlight-color: transparent; }
  .cta-button span { min-width: 0; font-family: system-ui, -apple-system, 'Segoe UI', sans-serif; font-size: clamp(17px, 4.8vw, 21px); font-weight: 800; line-height: 1.35; text-align: center; letter-spacing: .01em; }
  .cta-button b { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: #fff; color: #ff5a00; font-family: Arial, sans-serif; font-size: 36px; font-weight: 700; line-height: 1; padding-bottom: 4px; transition: transform 140ms ease; }
  .cta-button:hover { filter: brightness(1.035); transform: translateY(-1px); box-shadow: 0 6px 0 #cf4100, 0 12px 28px rgb(255 91 0 / 26%); }
  .cta-button:hover b { transform: translateX(2px); }
  .cta-button:active { transform: translateY(4px); box-shadow: 0 1px 0 #cf4100, 0 4px 10px rgb(255 91 0 / 18%); }
  .cta-button:focus-visible { outline: 4px solid rgb(0 150 136 / 38%); outline-offset: 4px; }
  .lp-footer { width: 100%; max-width: 430px; margin: 0 auto; padding: 28px 20px 32px; border-top: 1px solid #d8e7e5; background: #fff; color: #5c6e6b; font-size: 13px; line-height: 1.7; }
  .lp-footer__info { max-width: 360px; margin: 0 auto; }
  .lp-footer__info h2 { margin: 0 0 10px; color: #075f68; font-size: 16px; line-height: 1.4; }
  .lp-footer__info dl { display: grid; gap: 5px; margin: 0 0 12px; }
  .lp-footer__info dl > div { display: grid; grid-template-columns: 5.5em minmax(0, 1fr); gap: 12px; }
  .lp-footer__info dt, .lp-footer__info dd { margin: 0; }
  .lp-footer__info dt { color: #6f807d; }
  .lp-footer__info dd { color: #263b38; }
  .lp-footer a { color: #075f68; text-decoration: underline; text-underline-offset: .18em; }
  .lp-footer a:focus-visible { outline: 3px solid #ff8b33; outline-offset: 3px; }
  .lp-footer__info p { margin: 0; }
  .lp-footer__nav { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 16px; margin: 20px 0 14px; padding-top: 16px; border-top: 1px solid #e3eeec; }
  .lp-footer__nav a { display: inline-flex; align-items: center; min-height: 44px; }
  .lp-footer__copy { margin: 0; color: #6f807d; font-size: 12px; text-align: center; }
  @media (prefers-reduced-motion: reduce) { .cta-button, .cta-button b { transition: none; } }
  @media (max-width: 430px) { .lp { box-shadow: none; } }
  @media (max-width: 350px) { .cta-block { padding-inline: 14px; } .cta-button { grid-template-columns: minmax(0, 1fr) 40px; padding-left: 16px; } .cta-button b { width: 40px; height: 40px; } }
</style>
